# ============================================================
#  Suivi Chantier API — Variables d'environnement
#  Copier ce fichier en .env et remplir toutes les valeurs.
#  NE JAMAIS committer le fichier .env.
# ============================================================

# ── Cloudflare R2 (stockage des fichiers) ────────────────────
# Photos, videos, notes vocales, plans, documents, rapports : AUCUN contenu
# binaire n'est stocke en base ni sur le disque du serveur.
#
# Sans ces variables, l'application retombe automatiquement sur le disque local
# (<racine>/uploads) — pratique en developpement, a NE PAS utiliser en production.
#
# Deux regimes d'acces :
#   images/profils/, images/organisations/ -> PUBLIC (CDN Cloudflare, URL stockee)
#   plans/, documents/, rapports/, medias/, pieces/ -> PRIVE (bucket ferme,
#   servi par l'API apres controle des droits)
# Le bucket doit rester PRIVE : seul le prefixe images/ peut etre expose.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=suivie-chantier
# URL publique du bucket, utilisee uniquement pour le prefixe images/
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Taille maximale des medias de reserve (videos, notes vocales), en Mo.
# Les autres uploads (documents, plans, photos) restent plafonnes a 5 Mo.
UPLOAD_MAX_MEDIA_MB=100

# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Adresse d'ecoute (M11) : 127.0.0.1 en bare-metal derriere nginx, 0.0.0.0 en Docker.
# NE PAS mettre 0.0.0.0 ici : cette valeur sert au deploiement bare-metal/PM2, ou
# nginx proxifie 443 -> 127.0.0.1:3000. En Docker, docker-compose.prod.yml force
# HOST=0.0.0.0 dans son bloc environment: (un bind sur la loopback du conteneur
# serait injoignable depuis le reseau bridge, donc depuis nginx).
HOST=127.0.0.1

# Fuseau horaire des taches planifiees (src/jobs/*.job.js).
# Les crons sont exprimes en heure locale de ce fuseau : marquage des reserves en
# retard 22h00, rappels/escalade 07h00, purge des tokens lundi 00h00.
# Sans cette variable le defaut applique est Europe/Paris. NE PAS se fier au TZ
# systeme : il vaut UTC dans les conteneurs Docker (decalage de 1 a 2 h).
# Valeur = identifiant IANA (Europe/Paris, Africa/Dakar, UTC, ...).
CRON_TZ=Europe/Paris

# ── Logs ─────────────────────────────────────────────────────
# Chemin absolu du dossier de logs (cree automatiquement si absent en production)
# Defaut : <racine_projet>/logs
LOG_DIR=/var/www/suivie-chantier/logs
LOG_LEVEL=info

# ── Base de donnees PostgreSQL ────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=suivie_chantier
DB_USER=chantieruser
DB_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT

# ── Pool de connexions (⚠ a calibrer avec PM2_INSTANCES) ─────────────────────
# Le pool est defini PAR PROCESS : en mode cluster PM2, chaque worker ouvre son
# propre pool. Le total reel vaut donc :
#
#     connexions_totales = PM2_INSTANCES x DB_POOL_MAX  (+ 3 reservees superuser)
#
# et doit rester nettement SOUS le max_connections de PostgreSQL (defaut : 100).
# Avec les defauts historiques (PM2_INSTANCES=max -> 4 sur un VPS 4 vCPU,
# DB_POOL_MAX=20) on obtenait 80 connexions sur 100 : la moindre pointe, un
# `pm2 reload` (anciens + nouveaux workers coexistent) ou une session psql
# d'admin faisait tomber « FATAL: sorry, too many clients already ».
#
# Regle : DB_POOL_MAX <= (max_connections - 10) / PM2_INSTANCES
# Recommande sur VPS 4 vCPU / max_connections=100 : PM2_INSTANCES=4 + DB_POOL_MAX=10
# (soit 40 connexions, marge confortable pour un reload et les backups).
# Verifier la limite reelle : psql -c "SHOW max_connections;"
DB_POOL_MAX=10
DB_POOL_MIN=2

# SSL PostgreSQL : laisser vide si PostgreSQL est sur le meme serveur (loopback)
# Sinon : contenu du certificat CA en base64
DB_SSL_CA=

# ── JWT ──────────────────────────────────────────────────────
# Generer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_MOI_SECRET_JWT_64_CHARS_MIN
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_MOI_REFRESH_SECRET_DIFFERENT
JWT_RESET_SECRET=CHANGE_MOI_RESET_SECRET_DIFFERENT

# ── Chiffrement des donnees sensibles (M3) ───────────────────
# Cle AES-256 (32 octets) en base64 — OBLIGATOIRE en production.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Utilisee pour chiffrer mfa_secret et les autres champs sensibles au repos.
APP_ENC_KEY=CHANGE_MOI_CLE_32_OCTETS_BASE64

# ── Verification email (M5) ──────────────────────────────────
# true = l'inscription exige un email verifie avant connexion (recommandé).
# false = desactive (test local uniquement).
REQUIRE_EMAIL_VERIFICATION=true

# ── CORS ─────────────────────────────────────────────────────
# URL de l'app mobile / front — JAMAIS * en production
# Plusieurs origines : CORS_ORIGIN=https://app.suivie-chantier.com,https://admin.suivie-chantier.com
CORS_ORIGIN=https://YOUR_DOMAIN

# URL du frontend (utilisée pour les liens dans les emails, etc.)
FRONTEND_URL=https://YOUR_DOMAIN

# ── Admin par defaut ─────────────────────────────────────────
# Cree au 1er demarrage si absent. Obligatoire de changer ces valeurs.
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=ChangeMe_MotDePasseForte123!
ADMIN_NOM=Admin
ADMIN_PRENOM=Suivi
ADMIN_ADRESSE=Dakar, Senegal

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_REMPLACER_PAR_VOTRE_CLE
MAIL_FROM=SuiviChantier <noreply@votre-domaine.com>

# ── SMTP (alternative a Resend) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=REMPLACER_PAR_VOTRE_CLE_SECRETE
R2_BUCKET_NAME=suivie-chantier
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Firebase FCM (notifications push) ─────────────────────────
# Contenu JSON du fichier serviceAccount Firebase sur une seule ligne
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── HelloSign ─────────────────────────────────────────────────
HELLOSIGN_API_KEY=

# ── Stripe (abonnements SaaS) ────────────────────────────────
# Clés Stripe (test ou live) — créées sur dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_REMPLACER_PAR_VOTRE_CLE
STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACER_PAR_VOTRE_CLE
# Secret du webhook Stripe (pour vérifier la signature — endpoint /api/v1/abonnement/webhook)
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER_PAR_VOTRE_SECRET
# Price IDs des plans créés dans Stripe (un par plan)
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx
STRIPE_PRICE_BUSINESS=price_business_xxx

# ── PayTech (paiement mobile Africa) ──────────────────────────
# Clés PayTech (obtenues sur dashboard.paytech.sn après inscription)
PAYTECH_API_KEY=your_api_key_here
PAYTECH_API_SECRET=your_api_secret_here
# Environnement: test (dev) ou prod (production - nécessite activation manuelle)
PAYTECH_ENV=test
# Base URL de l'API PayTech (ne pas changer sauf 지시)
PAYTECH_BASE_URL=https://paytech.sn/api
# URL publique de votre API (pour les webhooks IPN)
API_PUBLIC_URL=https://api.votre-domaine.com

# ── Sauvegardes chiffrees (M7) ───────────────────────────────
# Cle de chiffrement des dumps PostgreSQL (AES-256-CBC) — OBLIGATOIRE pour deploy/backup-postgres.sh.
# Generer : openssl rand -hex 32
BACKUP_ENC_KEY=CHANGE_MOI_CLE_BACKUP_32_OCTETS_HEX

# ── Redis (rate limiting partage + cache dashboard) ───────────
# Sans cette variable, l'app demarre quand meme (repli sur un store memoire
# PAR PROCESS pour chaque limiteur, comportement historique) — mais en mode
# cluster PM2 (voir PM2_INSTANCES ci-dessous), chaque worker compte alors les
# tentatives de connexion SEPAREMENT : la limite anti brute-force annoncee
# (5 tentatives / 15 min) est en pratique divisee par le nombre de workers.
# OBLIGATOIRE en production des que PM2_INSTANCES > 1 (le mode par defaut).
# Avec `docker compose up` (dev ou prod), le service `redis` du compose est
# deja cable sur REDIS_URL=redis://redis:6379 — rien a faire de plus.
# Hors Docker (bare-metal + PM2) : installer Redis sur le VPS et renseigner
# son URL ici, ex: redis://127.0.0.1:6379 ou redis://:motdepasse@host:6379.
REDIS_URL=

# ── PM2 ──────────────────────────────────────────────────────
# Nombre d'instances PM2 : "max" = 1 par coeur CPU | 1 = single process.
# ⚠ Impacte directement le nombre de connexions PostgreSQL : voir le bloc
#   DB_POOL_MAX plus haut (connexions_totales = PM2_INSTANCES x DB_POOL_MAX).
# Note : sync(), le seed admin et les taches cron ne tournent QUE dans le worker
# d'index 0 (garde NODE_APP_INSTANCE dans src/server.js) — augmenter ce nombre
# ne duplique donc plus les notifications planifiees.
PM2_INSTANCES=max
