{
  "name": "suivie-chantier-api",
  "version": "1.0.0",
  "description": "Suivi Chantier — backend API Node.js/Express",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "seed:admin": "node -r dotenv/config src/scripts/seedAdmin.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop suivie-chantier-api",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production --update-env",
    "pm2:logs": "pm2 logs suivie-chantier-api",
    "pm2:status": "pm2 status suivie-chantier-api",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f backend",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "backup": "bash deploy/backup-postgres.sh",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "node-cron": "^4.4.1",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.18.1",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "ioredis-mock": {
      "ioredis": "$ioredis"
    },
    "@types/ioredis-mock": {
      "ioredis": "$ioredis"
    }
  }
}
